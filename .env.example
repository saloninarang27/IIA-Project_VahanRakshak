# ==============================================================================
# VehicleSentinel: Multi-Host & Microservices Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure as needed:
#   cp .env.example .env
#
# If the 5 database microservices (IIB, VAHAN, Police, ANPR, E-Challan) are hosted
# on another laptop, set REMOTE_HOST to that laptop's LAN IP (e.g. 192.168.1.50).
#
# If REMOTE_HOST is commented out, empty, or missing, the system automatically
# falls back to our own locally hosted APIs (127.0.0.1).
# ==============================================================================

# --- Global Remote Host (uncomment to point all 5 microservices to another laptop) ---
# REMOTE_HOST=192.168.1.50

# --- Or Individual Service Host Overrides (if hosted across multiple machines) ---
# HOST_IIB=192.168.1.50
# HOST_VAHAN=192.168.1.50
# HOST_POLICE=192.168.1.50
# HOST_ANPR=192.168.1.50
# HOST_ECHALLAN=192.168.1.50
# HOST_MEDIATOR=127.0.0.1

# --- Ports Configuration (Defaults to 5001-5006, 3000) ---
# PORT_FRONTEND=3000
# PORT_MEDIATOR=5001
# PORT_IIB=5002
# PORT_VAHAN=5003
# PORT_POLICE=5004
# PORT_ANPR=5005
# PORT_ECHALLAN=5006

# --- Cache Settings ---
# CACHE_TTL_SECONDS=300
